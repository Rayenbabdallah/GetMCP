{
  "name": "api",
  "version": "0.1.0",
  "description": "GetMCP API — Zero Trust proxy + audit ledger for AI agents",
  "author": "Rayen Babdallah",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/Rayenbabdallah/GetMCP",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rayenbabdallah/GetMCP.git",
    "directory": "apps/api"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "^5.22.0",
    "archiver": "^7.0.1",
    "axios": "^1.21.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/archiver": "^7.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.dto.ts",
      "!**/*.module.ts",
      "!main.ts",
      "!prisma.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "./src/audit/canonical.util.ts": {
        "statements": 95,
        "branches": 80,
        "functions": 100,
        "lines": 95
      },
      "./src/audit/audit.service.ts": {
        "statements": 70,
        "branches": 50,
        "functions": 70,
        "lines": 70
      },
      "./src/policy/policy.engine.ts": {
        "statements": 95,
        "branches": 75,
        "functions": 100,
        "lines": 95
      },
      "./src/policy/path-match.util.ts": {
        "statements": 85,
        "branches": 80,
        "functions": 100,
        "lines": 100
      },
      "./src/policy/rate-limiter.ts": {
        "statements": 90,
        "branches": 85,
        "functions": 50,
        "lines": 90
      },
      "./src/policy/reasoning.util.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/proxy/proxy.service.ts": {
        "statements": 90,
        "branches": 80,
        "functions": 80,
        "lines": 90
      },
      "./src/auth/api-key.util.ts": {
        "statements": 90,
        "branches": 75,
        "functions": 100,
        "lines": 90
      },
      "./src/slack/slack.signature.ts": {
        "statements": 95,
        "branches": 85,
        "functions": 100,
        "lines": 95
      },
      "./src/crypto.util.ts": {
        "statements": 90,
        "branches": 80,
        "functions": 100,
        "lines": 90
      },
      "./src/generator/heuristic.ts": {
        "statements": 85,
        "branches": 75,
        "functions": 100,
        "lines": 85
      },
      "./src/generator/spec-hash.util.ts": {
        "statements": 85,
        "branches": 70,
        "functions": 100,
        "lines": 85
      }
    }
  }
}
